(executable
 (name gen_readme)
 (modules gen_readme))

(executable
 (name testing_example)
 (modules testing_example)
 (libraries ache))

(rule
 (deps
  (glob_files ../eio/*.ml)
  (glob_files ../lwt/*.ml)
  (glob_files ../miou/*.ml)
  testing_example.ml)
 (action
  (progn
   (with-stdout-to
    ache.md.gen
    (run ./gen_readme.exe ../.. %{dep:../../docs/ache.md}))
   (with-stdout-to
    ache-eio.md.gen
    (run ./gen_readme.exe ../.. %{dep:../../docs/ache-eio.md}))
   (with-stdout-to
    ache-lwt.md.gen
    (run ./gen_readme.exe ../.. %{dep:../../docs/ache-lwt.md}))
   (with-stdout-to
    ache-miou.md.gen
    (run ./gen_readme.exe ../.. %{dep:../../docs/ache-miou.md}))))
 (targets ache.md.gen ache-eio.md.gen ache-lwt.md.gen ache-miou.md.gen))

(rule
 (alias runtest)
 (package ache)
 (action
  (progn
   (run %{exe:testing_example.exe})
   (diff ../../docs/ache.md ache.md.gen)
   (diff ../../docs/ache-eio.md ache-eio.md.gen)
   (diff ../../docs/ache-lwt.md ache-lwt.md.gen)
   (diff ../../docs/ache-miou.md ache-miou.md.gen))))
