(executable
 (name gen_readme))

(rule
 (deps
  (glob_files ../eio/*.ml)
  (glob_files ../lwt/*.ml)
  (glob_files ../miou/*.ml))
 (action
  (with-stdout-to
   README.md.gen
   (run ./gen_readme.exe ../.. %{dep:../../docs/README.md}))))

(rule
 (alias runtest)
 (package ache)
 (action
  (diff ../../docs/README.md README.md.gen)))
