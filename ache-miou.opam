# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Miou runtime for ache"
description:
  "Runs ache HTTP/1.1 servers and clients on Miou_unix sockets. The application must ignore SIGPIPE."
maintainer: ["David Sancho <dsnxmoreno@gmail.com>"]
authors: [
  "David Sancho <dsnxmoreno@gmail.com>"
  "Spiros Eliopoulos"
  "Antonio Nuno Monteiro"
]
license: "BSD-3-Clause"
tags: ["http" "http-server" "http-client" "web" "miou"]
homepage: "https://github.com/davesnx/ache"
doc: "https://ocaml.org/p/ache-miou/latest/doc/index.html"
bug-reports: "https://github.com/davesnx/ache/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.3"}
  "ache" {= version}
  "bigstringaf"
  "miou" {>= "0.10.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/davesnx/ache.git"
x-maintenance-intent: ["(latest)"]
