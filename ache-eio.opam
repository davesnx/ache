# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Eio runtime for ache"
description:
  "Runs ache HTTP/1.1 servers and clients on any Eio two-way flow, such as a TCP socket or a TLS flow."
maintainer: ["David Sancho <dsnxmoreno@gmail.com>"]
authors: [
  "David Sancho <dsnxmoreno@gmail.com>"
  "Spiros Eliopoulos"
  "Antonio Nuno Monteiro"
]
license: "BSD-3-Clause"
tags: ["http" "http-server" "http-client" "web" "eio"]
homepage: "https://github.com/davesnx/ache"
doc: "https://ocaml.org/p/ache-eio/latest/doc/index.html"
bug-reports: "https://github.com/davesnx/ache/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.3"}
  "ache" {= version}
  "bigstringaf"
  "cstruct"
  "eio"
  "eio_main" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/davesnx/ache.git"
x-maintenance-intent: ["(latest)"]
