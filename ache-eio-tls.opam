# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "TLS for the Eio runtime of ache"
description:
  "Runs ache HTTP/1.1 servers and clients over TLS on Eio flows, with ocaml-tls (tls-eio). A client reports a response that ends at the close of the connection without a TLS close_notify as an error."
maintainer: ["David Sancho <dsnxmoreno@gmail.com>"]
authors: [
  "David Sancho <dsnxmoreno@gmail.com>"
  "Spiros Eliopoulos"
  "Antonio Nuno Monteiro"
]
license: "BSD-3-Clause"
tags: ["http" "http-server" "http-client" "web" "eio" "tls"]
homepage: "https://github.com/davesnx/ache"
doc: "https://ocaml.org/p/ache-eio-tls/latest/doc/index.html"
bug-reports: "https://github.com/davesnx/ache/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.3"}
  "ache" {= version}
  "ache-eio" {= version}
  "domain-name"
  "eio"
  "ipaddr"
  "tls" {>= "2.1.5"}
  "tls-eio" {>= "2.1.5"}
  "eio_main" {with-test}
  "x509" {with-test}
  "ptime" {with-test}
  "mirage-crypto-rng" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/davesnx/ache.git"
x-maintenance-intent: ["(latest)"]
